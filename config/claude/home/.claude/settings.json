{
  "permissions": {
    "allow": [
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Read(~/.claude/settings.json)",
      "Read(~/.zshrc)",
      "Read(~/.config/zsh)",
      "WebFetch(domain:github.com)",
      "Bash(git fetch:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(ansible-vault view:*)",
      "Bash(ansible-playbook playbooks/server.yml --tags config,gemini --vault-password-file vault_password.txt)",
      "Bash(go build:*)",
      "Bash(make terraform-plan:*)",
      "Bash(terraform console:*)",
      "Bash(ansible-playbook -i hosts.yml site.yml --check)",
      "Bash(ssh -F /Users/s28628/projects/github.com/shiron-dev/infrastructure/compose/hosts/home-ep/ssh_config home-ep \"id shiron && docker ps -a --filter name=zigbee2mqtt\")",
      "Bash(ssh -F /Users/s28628/projects/github.com/shiron-dev/infrastructure/compose/hosts/home-ep/ssh_config home-ep \"docker logs zigbee2mqtt 2>&1 | tail -30\")"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/s28628/.claude/hooks/block-force-push.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "model": "opus[1m]"
}
